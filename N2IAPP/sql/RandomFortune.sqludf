create or replace function RandomFortune()
returns varchar(5000)
language sql
reads sql data
not deterministic
set option commit = *NONE,
           dbgview = *LIST,
           dynusrprf = *USER,
           usrprf = *USER
begin
  declare fortune varchar(5000);

  set fortune = http_get('https://helloacm.com/api/fortune/', '');

  set fortune = substring(fortune, 2, length(fortune) - 2);
  set fortune = replace(fortune, 'Ö"','"');
  set fortune = replace(fortune, '\n','');
  set fortune = replace(fortune, '\t',' ');

  return fortune;
end;
comment on function RandomFortune is 'Get a random fortune';
grant execute on function RandomFortune to PUBLIC;