PGM PARM(&e_PRINTER &e_NAME &e_USERDATA &e_SET)
  DCL VAR(&e_PRINTER) TYPE(*CHAR) LEN(10)
  DCL VAR(&e_NAME) TYPE(*CHAR) LEN(10)
  DCL VAR(&e_USERDATA) TYPE(*CHAR) LEN(10)
  DCL VAR(&e_SET) TYPE(*LGL)

  IF COND(&e_SET) THEN(OVRPRTF FILE(&e_PRINTER) SPLFNAME(&e_NAME) USRDTA(&e_USERDATA) OVRSCOPE(*JOB))
  ELSE CMD(DLTOVR FILE(&e_PRINTER) LVL(*JOB))
ENDPGM