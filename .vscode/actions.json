[
  {
    "name": "Create RPGLE Program",
    "command": "CRTBNDRPG PGM(&BRANCHLIB/&NAME) SRCSTMF('&RELATIVEPATH') OPTION(*EVENTF) DBGVIEW(*SOURCE) TGTCCSID(*JOB)",
    "deployFirst": true,
    "environment": "ile",
    "extensions": [
      "RPGLE"
    ],
    "type": "file"
  },
  {
    "name": "Create RPGLE Module",
    "command": "CRTRPGMOD MODULE(&BRANCHLIB/&NAME) SRCSTMF('&RELATIVEPATH') OPTION(*EVENTF) DBGVIEW(*SOURCE) TGTCCSID(*JOB)",
    "deployFirst": true,
    "environment": "ile",
    "extensions": [
      "RPGLE"
    ],
    "type": "file"
  },
  {
    "name": "Create SQLRPGLE Program",
    "command": "CRTSQLRPGI OBJ(&BRANCHLIB/&NAME) SRCSTMF('&RELATIVEPATH') OPTION(*EVENTF) DBGVIEW(*SOURCE) CLOSQLCSR(*ENDMOD) CVTCCSID(*JOB) COMPILEOPT('TGTCCSID(*JOB)') RPGPPOPT(*LVL2)",
    "deployFirst": true,
    "environment": "ile",
    "extensions": [
      "SQLRPGLE"
    ],
    "type": "file"
  },
  {
    "name": "Create SQLRPGLE Module",
    "command": "CRTSQLRPGI OBJ(&BRANCHLIB/&NAME) SRCSTMF('&RELATIVEPATH') OBJTYPE(*MODULE) OPTION(*EVENTF) DBGVIEW(*SOURCE) CLOSQLCSR(*ENDMOD) CVTCCSID(*JOB) COMPILEOPT('TGTCCSID(*JOB)') RPGPPOPT(*LVL2)",
    "deployFirst": true,
    "environment": "ile",
    "extensions": [
      "SQLRPGLE"
    ],
    "type": "file"
  },
  {
    "extensions": [
      "CLP",
      "CLLE"
    ],
    "name": "Create Bound CL Program",
    "command": "CRTBNDCL PGM(&BRANCHLIB/&NAME) SRCSTMF('&RELATIVEPATH') OPTION(*EVENTF) DBGVIEW(*SOURCE)",
    "deployFirst": true,
    "environment": "ile",
    "type": "file"
  },
  {
    "extensions": [
      "cmd"
    ],
    "name": "Create Command",
    "command": "CRTCMD CMD(&BRANCHLIB/&NAME) PGM(&BRANCHLIB/&NAME) SRCSTMF('&RELATIVEPATH') OPTION(*EVENTF)",
    "deployFirst": true,
    "environment": "ile",
    "type": "file"
  },
  {
    "extensions": [
      "SQL",
      "TABLE",
      "VIEW",
      "SQLPRC",
      "SQLUDF",
      "SQLUDT",
      "SQLTRG",
      "SQLALIAS",
      "SQLSEQ"
    ],
    "name": "Run SQL Statements (RUNSQLSTM)",
    "command": "RUNSQLSTM SRCSTMF('&FULLPATH') COMMIT(*NONE) NAMING(*SQL) DFTRDBCOL(&BRANCHLIB)",
    "deployFirst": true,
    "environment": "ile",
    "type": "file"
  },
  {
    "extensions": [
      "GLOBAL"
    ],
    "name": "Create TOOLS Service Program",
    "command": "CRTSRVPGM SRVPGM(&BRANCHLIB/TOOLS) EXPORT(*ALL) MODULE(&BRANCHLIB/OVRPRTF) ACTGRP(TOOLS)",
    "environment": "ile",
    "type": "file",
    "deployFirst": true,
    "refresh": "no",
    "runOnProtected": false
  },
  {
    "name": "Create CLLE Module",
    "command": "CRTCLMOD MODULE(&BRANCHLIB/&NAME) SRCSTMF('&RELATIVEPATH') OPTION(*EVENTF) DBGVIEW(*LIST) TGTCCSID(*JOB)",
    "deployFirst": true,
    "environment": "ile",
    "extensions": [
      "CLLE"
    ],
    "type": "file",
    "refresh": "no",
    "runOnProtected": false
  },
  {
    "name": "Create JOKESPOOL program",
    "type": "file",
    "environment": "ile",
    "command": "CRTPGM PGM(&BRANCHLIB/JOKESPOOL) MODULE(&BRANCHLIB/JOKESPOOL) ENTMOD(&BRANCHLIB/JOKESPOOL) BNDSRVPGM((&BRANCHLIB/TOOLS)) ACTGRP(*CALLER)",
    "refresh": "no",
    "deployFirst": false,
    "runOnProtected": false
  },
  {
    "name": "Build project",
    "type": "file",
    "extensions": [
      "SH"
    ],
    "environment": "pase",
    "command": "build.sh &BRANCHLIB",
    "refresh": "no",
    "deployFirst": true,
    "postDownload": [
      ".evfevent",
      ".logs"
    ],
    "runOnProtected": false
  }
]